DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_delivery_planner
REDIS_URL=redis://localhost:6379/0
JWT_SECRET=change-me
JWT_ALGORITHM=HS256
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
GOOGLE_MAPS_API_KEY=

# Gmail SMTP — leave GMAIL_ADDRESS/GMAIL_APP_PASSWORD empty to skip sending
# and just log the verification link instead. GMAIL_APP_PASSWORD is a Gmail
# "App Password" (requires 2FA on the account), not the account's real
# password: https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=
GMAIL_APP_PASSWORD=
FRONTEND_BASE_URL=http://localhost:5173

# Quantum territory planning — optional. Needs `pip install ".[quantum]"`.
# Empty IBM_QUANTUM_TOKEN = real-QPU solver disabled (simulator/emulator still work).
IBM_QUANTUM_TOKEN=
IBM_QUANTUM_INSTANCE=
IBM_QUANTUM_BACKEND=
IBM_QUANTUM_TIMEOUT_SECONDS=300
IBM_QUANTUM_MONTHLY_BUDGET_SECONDS=540
# Also run real-QPU circuits on Aer with the device noise model and store it in the ledger
QUANTUM_LEDGER_NOISE_MODEL_PREDICTION=false
